# 光伏面板缺陷检测系统 · 环境变量模板
# 用法：复制为 .env（与模板同目录，即 backend/.env），填入真实值后启动服务。
#   PowerShell:  Copy-Item .env.example .env
#   Linux:       cp .env.example .env && chmod 600 .env
# .env 已被 .gitignore 排除，永远不会提交到仓库。
# 真实环境变量优先级高于 .env（systemd / Docker / 云平台注入不受影响）。

# ================= 必填（生产） =================

# JWT 签名密钥——生产必须设置（PV_ENV=production 时缺失将拒绝启动）。
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
PV_SECRET_KEY=

# 阿里云百炼 API Key（智能体对话用；不部署 Agent 功能可留空）
# 获取：https://bailian.console.aliyun.com → API-KEY 管理
DASHSCOPE_API_KEY=

# ================= 推荐设置（生产） =================

# 运行环境标识：production 时强制校验 PV_SECRET_KEY
PV_ENV=production

# 允许的前端来源（逗号分隔；按实际域名修改）
PV_CORS_ORIGINS=https://your-domain.com

# ================= 云服务（WorkBuddy Cloud Service，可选） =================
# 启用后前端走云端邮箱验证码登录、会话存云数据库、图片存云对象存储，
# 智能体对话由浏览器直连云端大模型（keyless，服务端不再需要百炼 Key）。
# PV_CLOUD_ENDPOINT 取 activate 返回的 publicConfig.endpoint，与应用发布域名一致。

# PV_CLOUD_ENDPOINT=https://pv-defect-agent.app.workbuddy.host
# 应用公开凭据（publicConfig.publishableKey）：云端自省接口必需，缺失报 invalid_client
# PV_CLOUD_APP_KEY=wbpk_xxx
# PV_CLOUD_AUTH=true
# PV_CLOUD_AUTH_TTL=300
# PV_CLOUD_AUTH_TIMEOUT=6.0

# ================= 可选（默认值见 README 环境变量表） =================

# LLM 配置（默认即百炼，一般无需改动；启用云服务后此段仅作为服务端兜底）

# PV_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PV_LLM_MODEL=kimi-k3.1-pro
# PV_LLM_REASONING_EFFORT=high
# PV_AGENT_MAX_ROUNDS=6
# PV_KB_TOP_K=4

# 安全与限流
# PV_TOKEN_EXPIRE_MINUTES=1440
# PV_PWD_ITERATIONS=600000
# PV_LOGIN_RATE_LIMIT=8
# PV_REGISTER_RATE_LIMIT=30
# PV_RATE_LIMIT_WINDOW=60

# 业务参数
# PV_UPLOAD_MAX_MB=10
# PV_UPLOAD_MAX_PIXELS=40000000
# PV_CONF_THRESHOLD=0.25
# PV_IOU_THRESHOLD=0.45
# PV_IMGSZ=640
# PV_ORT_THREADS=4
